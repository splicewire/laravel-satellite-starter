{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "packageManager": "pnpm@9.15.3",
    "type": "module",
    "scripts": {
        "test:messages": "node scripts/check-host-messages.mjs",
        "build": "pnpm run types:check && vite build",
        "build:ssr": "pnpm run types:check && vite build && vite build --ssr",
        "dev": "composer types:generate && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "messages:collect": "schemastud-messages collect --out resources/beam/messages.json --write",
        "messages:check": "schemastud-messages collect --out resources/beam/messages.json",
        "types:check": "composer types:generate && tsc --noEmit && tsc -p tsconfig.generated.json && pnpm frame:vocabulary",
        "frame:vocabulary": "frame-vocabulary --readers @splicewire/beam-inertia/frame-readers",
        "beam:verify-prototype-boundary": "beam-verify-prototype-boundary"
    },
