{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "splicewire/laravel-satellite-starter",
    "type": "project",
    "description": "Start-from-scratch ground for a Splicewire satellite site — forks laravel-beam-starter and adds the splicewire/laravel-satellite backend stack (generation pipeline + splicewire/client connector).",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam-mdx.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-package-topology.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-graphine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-satellite.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/client.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-composition-spine-data.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-marquee.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "splicewire/laravel-beam": "*",
        "splicewire/laravel-beam-mdx": "*",
        "splicewire/laravel-satellite": "*",
        "schemastud/laravel-frame": "*",
        "schemastud/laravel-data-schemas": "*",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "phpunit/phpunit": "^12.5.23",
        "rushing/laravel-package-topology": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan splicewire:satellite:install --no-interaction --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "test:packages": [
            "@php bin/test-packages"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        },
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "spatie/laravel-package-tools": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
