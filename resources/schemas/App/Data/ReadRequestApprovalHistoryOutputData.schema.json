{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Request approval history",
    "properties": {
        "requestId": {
            "type": "integer"
        },
        "title": {
            "type": "string"
        },
        "currentApproval": {
            "type": "string"
        },
        "currentPin": {
            "type": [
                "string",
                "null"
            ]
        },
        "facts": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/RequestApprovalFactData"
            }
        }
    },
    "required": [
        "requestId",
        "title",
        "currentApproval",
        "currentPin",
        "facts"
    ],
    "$id": "ReadRequestApprovalHistoryOutputData",
    "$defs": {
        "RequestApprovalFactData": {
            "type": "object",
            "title": "Request approval fact",
            "properties": {
                "id": {
                    "type": "string"
                },
                "transition": {
                    "type": "string"
                },
                "from": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "to": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "actorReference": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "occurredAt": {
                    "type": "string"
                },
                "versionId": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "definitionStatus": {
                    "type": "string"
                },
                "definitionKey": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "definitionName": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "definitionVersion": {
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "transition",
                "from",
                "to",
                "actorReference",
                "occurredAt",
                "versionId",
                "definitionStatus",
                "definitionKey",
                "definitionName",
                "definitionVersion"
            ]
        }
    }
}