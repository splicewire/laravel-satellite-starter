            "x-stud-widget-contexts": {
                "list-column": {
                    "participates": true,
                    "sort": 1,
                    "label": "External ID"
                }
            }
        },
        "title": {
            "type": "string",
            "x-stud-widget-contexts": {
                "list-column": {
                    "participates": true,
                    "sort": 2,
                    "label": "Title"
                }
            }
        },
        "status": {
            "type": "string",
            "x-stud-widget-contexts": {
                "list-column": {
                    "participates": true,
                    "widget": "badge",
                    "sort": 3,
                    "label": "Status"
                }
            }
