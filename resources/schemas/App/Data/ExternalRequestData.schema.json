{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "External request",
    "properties": {
        "id": {
            "type": "string",
            "title": "ID"
        },
        "source": {
            "type": "string",
            "title": "Source",
            "x-stud-widget-contexts": {
                "list-column": {
                    "participates": true,
                    "sort": 0,
                    "label": "Source"
                }
            }
        },
        "externalId": {
            "type": "string",
